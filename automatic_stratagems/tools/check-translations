#!/usr/bin/env python3
"""Replay every calibrated mission panel across the supported x offsets."""

import argparse
import json
from pathlib import Path
import sys
import time

from PIL import Image


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))

from automatic_stratagems.scanner.stratagem_detection import (  # noqa: E402
    catalog,
    detect_mission_icons,
)


OFFSETS = (-30, -15, 0, 15, 30)
FIXTURES = ROOT / 'automatic_stratagems' / 'tests' / 'fixtures'
DEFAULT_OUTPUT = Path('/tmp/hd2-mission-translation-results.json')


def expectations():
    manifest = json.loads((FIXTURES / 'manifest.json').read_text())
    return next(dataset['expected_ids'] for dataset in manifest['datasets']
                if dataset['id'] == 'mission-panels')


def run(output):
    expected_by_file = expectations()
    panel_directory = FIXTURES / 'mission-panels'
    files = sorted(panel_directory.glob('*.png'))
    names = {path.name for path in files}
    if names != set(expected_by_file):
        missing = sorted(set(expected_by_file) - names)
        extra = sorted(names - set(expected_by_file))
        raise ValueError(f'Mission fixture inventory mismatch: missing={missing}, extra={extra}')

    entries = catalog()
    cases = []
    for path in files:
        expected = expected_by_file[path.name]
        with Image.open(path) as source:
            panel = source.convert('RGB')
        for offset in OFFSETS:
            started = time.monotonic()
            image = Image.new('RGB', (5120, 2160))
            image.paste(panel, (offset, 0))
            error = None
            try:
                actual = [row['id'] for row in detect_mission_icons(image, entries)]
            except Exception as caught:
                actual = None
                error = f'{type(caught).__name__}: {caught}'
            passed = error is None and actual == expected
            cases.append({
                'fixture': path.name,
                'offset_x': offset,
                'expected_ids': expected,
                'actual_ids': actual,
                'status': 'passed' if passed else 'failed',
                'error': error,
                'seconds': round(time.monotonic() - started, 4),
            })

    failures = sum(case['status'] != 'passed' for case in cases)
    artifact = {
        'schema_version': 1,
        'profile': {
            'language': 'English',
            'canvas': [5120, 2160],
            'background': 'black',
            'offsets_x': list(OFFSETS),
            'fixtures': len(files),
        },
        'total': len(cases),
        'passed': len(cases) - failures,
        'failed': failures,
        'cases': cases,
    }
    output = Path(output)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(artifact, indent=2) + '\n')
    print(f"{artifact['passed']}/{artifact['total']} mission translation cases passed; {output}")
    return 1 if failures else 0


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', type=Path, default=DEFAULT_OUTPUT,
                        help=f'per-case JSON artifact (default: {DEFAULT_OUTPUT})')
    args = parser.parse_args(argv)
    return run(args.output)


if __name__ == '__main__':
    raise SystemExit(main())
